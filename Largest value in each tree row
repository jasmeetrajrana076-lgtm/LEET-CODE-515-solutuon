class Solution {
public:
    vector<int> largestValues(TreeNode* root) {
        if(root==NULL) return {};
        
        queue<TreeNode*>q;
        vector<int>ans;
        q.push(root);
        TreeNode* temp;
        while(!q.empty())
        {
            int size = q.size();
            int largest = INT_MIN;
            for(int i=0;i<size;i++)
            {

                temp = q.front();
                q.pop();

                if(temp->left!=NULL)
                {
                    q.push(temp->left);
                }
                if(temp->right!=NULL)
                {
                    q.push(temp->right);
                }
                if(temp->val>largest)
                {
                    largest = temp->val;
                }
            }
            ans.push_back(largest);
        }
        return ans;
    }
};
